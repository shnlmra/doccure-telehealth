# ==========================================
# Database Configuration (PostgreSQL)
# ==========================================
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=telehealth_user
POSTGRES_PASSWORD=telehealth_secure_pass_123
POSTGRES_DB=telehealth_db

# ==========================================
# Backend Configuration (Nest.js)
# ==========================================
BACKEND_PORT=4000
NODE_ENV=development

# JWT Secret for authentication (Boilerplate)
JWT_SECRET=super_secret_jwt_key_change_me_in_production

# ==========================================
# Frontend Configuration (Next.js)
# ==========================================
FRONTEND_PORT=3000
# Next.js client-accessible backend URL
NEXT_PUBLIC_API_URL=http://localhost:4000/api
